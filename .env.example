# Resend (https://resend.com) - API key para el envío de mails del formulario de contacto
NUXT_RESEND_API_KEY=

# Email donde querés recibir los mensajes del formulario de contacto
NUXT_CONTACT_TO_EMAIL=jonatan.monti@hotmail.com

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) - protección anti-bot del formulario de contacto
# En desarrollo (npm run dev) no hace falta configurarlas: el módulo usa automáticamente las site/secret keys de prueba de Cloudflare.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
